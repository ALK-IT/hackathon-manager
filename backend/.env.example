DATABASE_URL=postgresql+asyncpg://hackathon:hackathon@localhost:5432/hackathon_manager
TEST_DATABASE_URL=postgresql+asyncpg://hackathon:hackathon@localhost:5432/hackathon_manager_test
REDIS_URL=redis://localhost:6379/0
# Required. Generate with: openssl rand -hex 32
JWT_SECRET_KEY=replace-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
# Enable only when requests can reach the app exclusively through a trusted reverse proxy.
TRUST_PROXY_HEADERS=false
FRONTEND_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173
RATE_LIMIT_LOGIN_REQUESTS=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=60
RATE_LIMIT_REGISTER_REQUESTS=5
RATE_LIMIT_REGISTER_WINDOW_SECONDS=3600
RATE_LIMIT_REFRESH_REQUESTS=30
RATE_LIMIT_REFRESH_WINDOW_SECONDS=60
RATE_LIMIT_VERIFY_EMAIL_REQUESTS=20
RATE_LIMIT_VERIFY_EMAIL_WINDOW_SECONDS=300
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_STARTTLS=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@hackathon-manager.local
# Required. Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RESOURCE_ENCRYPTION_KEY=replace-me
